# --- IA (Claude Haiku 5.5) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=80

# --- Base de datos y acceso del equipo (Supabase). Sin estas variables la app corre en modo local. ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Correo transaccional (Resend) ---
RESEND_API_KEY=
RESEND_FROM="FUNDIGSAC <avisos@tudominio.com>"

# --- Notificaciones push (generar con: npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:marketing@tudominio.com

# --- Tarea programada ---
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
